# ---------------------------------------------------------------------------
# Required now (T0)
# ---------------------------------------------------------------------------

# Auth (Clerk) — Clerk dashboard > API keys > Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (Neon)
# DATABASE_URL : connection pooling ON  (host contains "-pooler") — used at runtime
# DIRECT_URL   : connection pooling OFF                          — used by prisma migrate
# Two URLs are required because Neon's pooler runs in transaction mode and
# cannot hold the advisory locks migrations need.
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Added in later phases — leave blank until the milestone that needs them.
# The matching npm packages are installed at the same time (see README).
# ---------------------------------------------------------------------------

# Phase 1 — Darija conversational AI
OPENAI_API_KEY=

# Phase 1 — Clerk webhook user sync (lazy sync is used until then)
CLERK_WEBHOOK_SECRET=

# Phase 2 — File storage (Cloudflare R2), private objects + signed URLs
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Phase 12 — Mockup image generation (Replicate / fal.ai)
REPLICATE_API_TOKEN=

# Phase 12 — Background jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Phase 20 — Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Later — Email
RESEND_API_KEY=

# Later — Monitoring
SENTRY_DSN=
