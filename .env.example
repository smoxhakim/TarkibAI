# ---------------------------------------------------------------------------
# Required now (T0)
# ---------------------------------------------------------------------------

# Auth (Clerk) — Clerk dashboard > API keys > Next.js
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (Neon)
# DATABASE_URL : connection pooling ON  (host contains "-pooler") — used at runtime
# DIRECT_URL   : connection pooling OFF                          — used by prisma migrate
# Two URLs are required because Neon's pooler runs in transaction mode and
# cannot hold the advisory locks migrations need.
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@host.region.aws.neon.tech/neondb?sslmode=require

# AI (OpenAI) — the Darija conversation. Without this the app still runs; the
# chat endpoint returns 503 and the panel says the assistant is not configured.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Added in later phases — leave blank until the milestone that needs them.
# The matching npm packages are installed at the same time (see README).
# ---------------------------------------------------------------------------

# Later — Clerk webhook user sync (lazy sync is used until then)
CLERK_WEBHOOK_SECRET=

# File storage (Cloudflare R2). Private objects, signed short-lived URLs.
# Without these the app still runs; file endpoints return 503 and the panel
# says storage is not configured.
# The bucket needs CORS allowing PUT from the app origin, because uploads go
# from the browser straight to R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Mockup image generation (Replicate). Without this the app runs; the mockup
# panel says generation is not configured.
REPLICATE_API_TOKEN=

# Optional model overrides. Defaults are flux-1.1-pro (concept) and
# flux-kontext-pro (placing a design onto a real site photo).
REPLICATE_CONCEPT_MODEL=
REPLICATE_SITE_MODEL=

# Background jobs (Inngest). Locally, run `npx inngest-cli@latest dev` and leave
# these blank — the app detects dev mode automatically. Production REQUIRES
# INNGEST_SIGNING_KEY, which is what authenticates the job runner's calls to
# /api/inngest.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Billing — no provider chosen.
#
# Stripe does not support Moroccan businesses as merchants, so the keys that
# used to be listed here were for a service this product cannot use. The
# realistic options are local (CMI, bank transfer, cash on delivery) and the
# choice waits until billing is actually built.

# Later — Email
RESEND_API_KEY=

# Later — Monitoring
SENTRY_DSN=
