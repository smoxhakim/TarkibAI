// Prisma schema for TARKIB.
// Postgres is hosted on Neon. `url` is the pooled connection used at runtime;
// `directUrl` is the non-pooled connection required by `prisma migrate`, because
// Neon's pooler runs in transaction mode and cannot execute migration DDL/advisory locks.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  clerkId            String   @unique
  email              String   @unique
  name               String?
  companyName        String?
  logoUrl            String?
  stripeCustomerId   String?
  subscriptionPlan   String   @default("trial") // trial | starter | pro
  subscriptionStatus String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects      Project[]
  materials     Material[]
  auditEvents   AuditEvent[]
  costSettings  CostSettings?
  quoteSettings QuoteSettings?
  quotes        Quote[]
}

/// A user's private costing rules. These are business secrets: they determine
/// margin and never appear on anything a client sees.
model CostSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  /// percent | fixed. "percent" reads the matching *Bp field as basis points
  /// applied to the MATERIAL cost; "fixed" reads the *Cents field.
  laborType  String @default("percent")
  laborBp    Int    @default(0)
  laborCents Int    @default(0)

  /// percent | fixed | manual. "manual" means the amount is entered per project
  /// rather than derived from a rule.
  transportType  String @default("manual")
  transportBp    Int    @default(0)
  transportCents Int    @default(0)

  installType  String @default("percent")
  installBp    Int    @default(0)
  installCents Int    @default(0)

  /// Basis points: 1250 = 12.5%. Integer, so the arithmetic stays exact, while
  /// still expressing the half-percents real pricing uses.
  /// Margin applies to the internal total; tax applies to the client subtotal.
  marginBp Int @default(0)
  taxBp    Int @default(0)

  currency String @default("MAD")
}

/// A user's quotation identity and defaults. Everything here is printed on a
/// client-facing document, so nothing private belongs on this model.
model QuoteSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  /// Company block printed at the head of every quote. Seeded from
  /// User.companyName the first time the row is created, then authoritative:
  /// the account name and the name a client sees need not be the same.
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?

  /// Tax/registration identifiers a Moroccan quote is expected to carry
  /// (ICE, RC, IF). Free text, because the set differs by business form.
  taxIdentifiers String?

  /// R2 object key for the company logo, never a URL. Same rule as project
  /// files (ARCHITECTURE 7): reads are signed and short-lived.
  logoObjectKey String?
  logoMimeType  String?

  primaryColorHex String?
  footerText      String?
  termsText       String?
  paymentDetails  String?

  /// Default validity window printed on a quote, in days.
  validityDays Int @default(30)

  /// Prefix for generated quote numbers, e.g. "Q" gives "Q-2026-0001".
  numberPrefix String @default("Q")
}

model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  title  String

  /// The fabrication trade this project belongs to (src/lib/domains).
  ///
  /// Decides which specification fields must be answered before approval, what
  /// vocabulary the agent uses, which canvas objects are offered, and what
  /// counts as an implausible dimension. It does NOT reach the calculation
  /// engines: material requirements, cutting, waste and cost are the same
  /// arithmetic in every trade.
  ///
  /// Defaults to signage, which is what every project created before T17 is.
  domain String @default("signage")

  // Workflow stage. "archived" is deliberately NOT a value here: archiving is
  // orthogonal to progress, so it is tracked by archivedAt. That way restoring a
  // project returns it to the stage it had reached rather than losing it.
  status String @default("intake") // intake|spec_approved|calculated|quoted|production_ready

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages         ChatMessage[]
  files            File[]
  specs            ProjectSpec[]
  versions         ProjectVersion[]
  projectMaterials ProjectMaterial[]
  cuttingPlans     CuttingPlan[]
  cuttingPieces    CuttingPiece[]
  linearCuts       LinearCut[]
  diagrams         Diagram[]
  mockups          Mockup[]
  costs            ProjectCost[]
  documents        Document[]
  quotes           Quote[]
  auditEvents      AuditEvent[]
  projectExpenses  ProjectExpense[]
  canvasScene      CanvasScene?
  designProposals  DesignProposal[]

  @@index([userId, archivedAt])
}

model ChatMessage {
  id                String  @id @default(uuid())
  projectId         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role              String // user|assistant
  content           String
  /// File ids attached to this message, as a JSON array of strings.
  attachmentFileIds Json?

  // Audit trail of tools the agent invoked on this turn (name + arguments).
  // The conversation sent to the model is rebuilt from the structured spec plus
  // plain user/assistant text, so tool plumbing is NOT replayed from here —
  // chat history is not the source of truth (PRD §9).
  toolCalls Json?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model File {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  type      String // photo|logo|sketch|reference|mockup_source|generated_diagram|generated_mockup

  /// R2 object key. Deliberately NOT a URL: a stored URL would be a standing
  /// grant of access to anyone who reads the row or a log line. Every read goes
  /// through an ownership check and a short-lived signed URL (ARCHITECTURE §8, §9).
  objectKey String @unique

  /// Name the user's file had on their machine, for display only. Never used to
  /// build the object key, which is generated server-side.
  originalName String

  mimeType  String
  sizeBytes Int

  /// pending until the browser's direct-to-R2 upload is confirmed and the object
  /// verified. Only "ready" files are ever shown or sent to the model.
  status String @default("pending") // pending|ready

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model ProjectSpec {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int
  data       Json
  status     String    @default("draft") // draft|approved
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

/// A restorable snapshot of a whole project at one moment.
///
/// Written at the points where something became authoritative — a specification
/// approved, a design accepted, a quote issued, a package generated — and
/// whenever the user asks for one. Deliberately NOT written on every material
/// or cost recalculation: those run often and are already auditable at row
/// level through their own input snapshots, and a timeline flooded with them
/// would hide the moments that matter.
///
/// Versions are append-only. Restoring writes a new draft and a new version; it
/// never edits or removes an earlier one, because documents already issued
/// refer back to the state recorded here.
model ProjectVersion {
  id            String  @id @default(uuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  label         String

  /// spec_approved | design_approved | quote_issued | production_generated |
  /// manual | restored
  reason String @default("manual")

  /// The user's own note, when they took the snapshot deliberately.
  note String?

  specSnapshot Json

  /// Internal cost as it stood. Private, like every other cost figure: versions
  /// are an internal record and never feed a client document.
  costSnapshot Json?

  /// Canvas scene objects, so a design state can be reviewed and restored.
  canvasSnapshot Json?

  /// Project material lines with their calculated results and caveats.
  materialsSnapshot Json?

  /// Which drawings, quotes and packages existed at this point, so a document
  /// on a desk can be traced to the project state behind it.
  referenceSnapshot Json?

  createdAt DateTime @default(now())

  quotes    Quote[]
  documents Document[]

  @@unique([projectId, versionNumber])
  @@index([projectId, createdAt])
}

model Material {
  id             String  @id @default(uuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  name           String
  category       String
  customCategory Boolean @default(false)
  supplier       String?

  /// How this material is measured and purchased, which decides which of the
  /// dimension fields below apply and what unitPriceCents refers to.
  /// linear | sheet | area | piece  (ARCHITECTURE §11)
  measurementModel String

  /// Standard stock dimensions in INTEGER MILLIMETRES.
  ///
  /// Integers, not floats: purchase counts are derived from these, and a
  /// floating-point remainder can flip a division and change how many bars or
  /// sheets someone buys. Millimetres cover every fabrication size exactly.
  ///
  /// linear -> standardLengthMm (e.g. a 6 m bar is 6000)
  /// sheet  -> sheetWidthMm + sheetHeightMm (e.g. 2440 x 1220)
  /// area   -> priced per m², no discrete stock size
  /// piece  -> sold individually, no dimensions required
  standardLengthMm Int?
  sheetWidthMm     Int?
  sheetHeightMm    Int?

  /// Millimetres. Decimal because real stock includes 0.5 mm and 3.5 mm.
  thicknessMm Decimal? @db.Decimal(8, 2)

  /// Price of ONE purchase unit, in minor currency units of the user's
  /// configured currency:
  ///   linear -> one standard-length bar
  ///   sheet  -> one sheet
  ///   area   -> one square metre
  ///   piece  -> one piece
  unitPriceCents Int

  /// Extensible domain properties (kerf, minimum usable remnant, finish, colour…).
  /// Kept out of dedicated columns so industry-specific rules can be added
  /// without reshaping the core entity (ARCHITECTURE §11).
  technicalProperties Json?

  notes String?

  /// Archived rather than deleted once referenced by a project, so historical
  /// calculations and quotes keep pointing at a material that still exists.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projectMaterials ProjectMaterial[]
  cuttingPlans     CuttingPlan[]
  cuttingPieces    CuttingPiece[]
  linearCuts       LinearCut[]

  @@index([userId, archivedAt])
  @@index([userId, category])
}

model ProjectMaterial {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  /// What the material is for on this project, in the user's own words.
  role String?

  /// How much of this material the project needs, stated by the user.
  /// Units follow the material's measurementModel: metres for linear, square
  /// metres for sheet and area, a count for piece.
  ///
  /// This is an INPUT, not a result. The engine derives everything below from
  /// it; it never invents it, because deriving a requirement from spec
  /// dimensions would mean assuming how the sign is built (PRD §5.3).
  requiredQuantity Decimal?

  /// Optional note recording how the user arrived at the requirement, e.g.
  /// "perimeter 2x(8+3)". Kept for auditability of a number the system did not
  /// compute.
  requiredDimensions String?

  /// When the requirement itself last changed.
  ///
  /// Deliberately separate from `updatedAt`: the calculation writes its results
  /// to this same row, which bumps `updatedAt`, so `updatedAt` cannot
  /// distinguish "the user changed the quantity" from "we just calculated".
  /// Using it for staleness marked every line stale the moment it was
  /// calculated.
  requirementUpdatedAt DateTime?

  /// Results. NULL until the calculation engine runs, never zero-filled.
  unitsToPurchase        Int?
  totalPurchasedQuantity Decimal?
  wasteQuantity          Decimal?
  wastePercent           Decimal?
  unitPriceCentsSnapshot Int?
  totalCostCents         Int?
  calculatedAt           DateTime?

  /// The material's stock dimensions and price as they were at calculation
  /// time. Without this, editing a material later would silently rewrite the
  /// explanation of a calculation that was already run and possibly quoted.
  calculationInputs Json?

  /// Approved spec version the calculation was run against, so the UI can warn
  /// that a newer approved spec has superseded it (PRD §24 stale data).
  specVersionAtCalculation Int?

  /// Set when the engine cannot support this material, e.g. stock dimensions
  /// are missing. The line stays uncalculated and says why, rather than
  /// producing a number nobody can justify.
  unsupportedReason String?

  manualOverride Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One row per material per project; quantities belong in the fields above,
  /// not in duplicate rows.
  @@unique([projectId, materialId])
  @@index([projectId])
}

/// A required cut length for a linear material — bar, tube or profile.
///
/// The 1D counterpart of CuttingPiece. Kept separate rather than reusing a
/// height field that would be meaningless: a bar cut has one dimension, and
/// pretending otherwise invites a wrong number into the optimiser.
model LinearCut {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  label    String?
  lengthMm Int
  quantity Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, materialId])
}

/// The pieces to cut from one sheet material on a project.
///
/// Nesting needs individual piece dimensions, which a total area cannot supply.
/// These are stated by the user: how a facade divides into panels is a
/// fabrication decision involving seams and joins that the system cannot infer.
model CuttingPiece {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  label    String?
  widthMm  Int
  heightMm Int
  quantity Int     @default(1)

  /// False for materials with a grain or print direction, where a 90° turn
  /// would spoil the piece.
  allowRotation Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, materialId])
}

/// A computed cutting layout for one material on one project.
model CuttingPlan {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  /// sheet | linear. One plan per material, and a material is one or the other.
  kind String @default("sheet")

  /// e.g. "2440 × 1220 mm" for a sheet, "6 m bar" for linear stock.
  stockSizeLabel String

  /// Placements/cut sequence, offcuts or remnants, and the settings used. Read
  /// through a validated schema, never trusted raw.
  layoutData Json

  /// Whole stock units consumed: sheets for a sheet plan, bars for a linear one.
  stockUnitsUsed Int
  wastePercent   Decimal

  /// Cut settings in force when the plan was computed, so a layout stays
  /// explicable after the material's technical properties are edited.
  kerfMm       Int
  edgeMarginMm Int

  /// R2 object key for the rendered PNG diagram. Null when storage is not
  /// configured — the SVG still renders in the app either way.
  diagramObjectKey String?

  /// Pieces that could not be placed, with the reason. A plan is stored even
  /// when incomplete, because silently dropping a piece would be worse.
  unplacedCount Int @default(0)

  createdAt DateTime @default(now())

  @@unique([projectId, materialId])
  @@index([projectId])
}

/// An issued technical drawing — a numbered snapshot of the views as they were
/// when someone deliberately captured them.
///
/// The workspace always renders drawings live from current data, so what is on
/// screen can never be stale. This table exists for the other requirement: a
/// production document must point at the drawing a workshop was actually given,
/// which live rendering cannot guarantee.
model Diagram {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Sequential per project, so a workshop can be told "drawing 3".
  version Int

  /// Views included in this issue, e.g. ["front","side","top"].
  views Json

  /// The rendered SVG. Stored as text so an issued drawing is reproducible
  /// exactly, independent of any later change to the renderer.
  svg String

  /// The scene and spec the drawing was made from, for auditability.
  sourceSnapshot Json

  /// R2 key for a rendered PNG, used by production documents. Null when storage
  /// is not configured; the stored SVG remains the real artefact.
  imageObjectKey String?

  /// Free-text note, e.g. "issued to workshop".
  label String?

  createdAt DateTime @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

/// A generated presentation visual.
///
/// A mockup is a PRESENTATION AID, not production geometry. It is generated by
/// an image model from a text prompt and optionally a site photo, so it will
/// look plausible without being dimensionally accurate. Nothing derived from a
/// mockup may feed a calculation (PRD §17, §21).
model Mockup {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// concept | site
  kind String @default("concept")

  /// Source site photo for a real-environment mockup. References File.id.
  sourceFileId String?

  /// The prompt actually sent, kept so a result can be explained and repeated.
  prompt String

  /// Model identifier used, so an old mockup can be attributed correctly after
  /// the default model changes.
  model String?

  /// queued | running | succeeded | failed
  status String @default("queued")

  /// R2 object key for the generated image. Null until the job succeeds.
  resultObjectKey String?

  /// Why a generation failed, shown to the user rather than a blank card.
  failureReason String?

  /// Snapshot of the project facts the prompt was built from, for auditability.
  promptSource Json?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([status])
}

/// A computed cost breakdown for one project.
///
/// Everything from materialsCostCents through marginCents is INTERNAL and must
/// never reach a client document. Only clientSubtotalCents, taxCents and
/// clientTotalCents are client-safe, and only via toClientSafeCost().
model ProjectCost {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // ---- Internal, private ----
  materialsCostCents Int
  laborCostCents     Int
  transportCostCents Int
  installCostCents   Int
  otherCostCents     Int @default(0)
  internalTotalCents Int
  marginCents        Int

  // ---- Client-facing ----
  clientSubtotalCents Int
  taxCents            Int
  clientTotalCents    Int

  /// The rules and rounding in force when this was computed, so the breakdown
  /// stays explicable after the user edits their cost settings.
  settingsSnapshot Json?

  /// Set when a material calculation changed after this cost was computed.
  materialsCalculatedAt DateTime?

  computedAt DateTime @default(now())

  @@index([projectId, computedAt])
}

/// The structured visual representation of a project (ARCHITECTURE §14).
///
/// One current scene per project. The scene is a PROJECTION of the approved
/// specification plus layout detail — the spec remains the source of truth
/// (PRD §9), so the scene records which spec version it was built from and is
/// flagged as diverged rather than silently overriding an agreed dimension.
model CanvasScene {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Scene objects and canvas metadata. Structured JSON rather than a table per
  /// object type: the shape is still evolving, and every read and write goes
  /// through a validated schema in src/lib/canvas.
  data Json

  /// Approved spec version this scene was seeded from, so divergence is
  /// detectable instead of assumed.
  specVersionAtSeed Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A change to the project's design proposed by the AI agent, awaiting the
/// user's decision.
///
/// The agent has NO tool that mutates the canvas directly. It can only propose,
/// and a proposal does nothing until a person approves it (PRD §5.4, §11). The
/// same rows are the design revision history: an approved proposal records what
/// changed, when, and why.
model DesignProposal {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Plain-language description the user reads before deciding. Written by the
  /// agent, but it is only ever text — the commands below are what execute.
  summary String

  /// Validated canvas commands. Applied only on approval, and re-validated then
  /// so a scene that changed in the meantime cannot be corrupted.
  commands Json

  /// Optional specification patch for changes that alter an agreed project fact,
  /// such as a dimension. Approving the proposal writes this as a new DRAFT spec
  /// version; it still has to pass the normal spec approval before it counts.
  specPatch Json?

  /// pending | approved | rejected | superseded
  status String @default("pending")

  /// Set when applying failed, e.g. the target object was deleted meanwhile.
  failureReason String?

  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

/// A one-off expense for a single project — crane hire, a permit, a subcontractor.
/// Internal only; it feeds the internal total, never a client line item.
model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([projectId])
}

/// A generated production package for the workshop.
///
/// Unlike Quote, this model carries no structured data of its own. The package
/// is a rendering of project state that already exists — drawing, material
/// lines, cutting plans — so what is frozen here is a reference to that state
/// plus the notes written for the shop floor at generation time.
///
/// No money appears on this model or on the document it produces. The workshop
/// needs quantities and specifications, not prices, and a package that reaches
/// a subcontractor should not carry the business's costs with it.
model Document {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// production. Client quotations are their own model, because they carry
  /// structured commercial data this one deliberately does not.
  type String @default("production")

  /// Sequential per project and type, so a workshop can be told
  /// "production package 2".
  version Int

  /// Instructions for the shop floor, written when the package is generated and
  /// frozen onto it.
  notes String?

  /// R2 object key for the rendered PDF. Never a URL: reads are signed and
  /// short-lived, like every other stored object.
  pdfObjectKey String?

  /// What the package was built from — spec version, drawing version, material
  /// calculation time, plan ids — so a sheet on a bench can be traced back to
  /// the project state that produced it.
  sourceSnapshot Json?

  /// The version recorded when this package was generated.
  projectVersionId String?
  projectVersion   ProjectVersion? @relation(fields: [projectVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([projectId, type, version])
  @@index([projectId, createdAt])
}

/// A client-facing quotation.
///
/// Every amount on this model is a CLIENT price. Purchase prices, labour,
/// internal expenses and margin are deliberately absent rather than filtered
/// out on read: a column that does not exist cannot leak into a PDF
/// (ARCHITECTURE 15). The link back to the internal calculation is
/// `sourceCostId` alone, and rendering never dereferences it.
model Quote {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Quote numbers run per business, not per project, which is why the user is
  /// referenced directly rather than reached through the project.
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Per-user sequence behind `number`. Unique so two concurrent issues cannot
  /// hand the same number to two different clients.
  sequence Int
  number   String

  /// draft | issued. A draft is editable. An issued quote is frozen: a number
  /// that has reached a client must keep meaning the same thing.
  status String @default("draft")

  title       String
  description String?

  clientName    String
  clientAddress String?
  clientPhone   String?
  clientEmail   String?

  /// Client-facing money, integer minor units. `subtotalCents` is the sum of
  /// the line totals, not a copy of the internal calculation.
  subtotalCents Int
  taxBp         Int
  taxCents      Int
  totalCents    Int
  currency      String

  /// The ProjectCost this quote was seeded from, so a quote stays traceable to
  /// the calculation behind it and divergence can be shown to the user.
  sourceCostId String?

  /// The project state this quote was issued from. Set at issue, not at
  /// creation: a draft is still moving, an issued quote is not.
  projectVersionId String?
  projectVersion   ProjectVersion? @relation(fields: [projectVersionId], references: [id], onDelete: SetNull)

  /// Optional mockup printed on the quote. References Mockup.id.
  mockupId String?

  /// Company block, terms and payment details as they stood at issue. An
  /// issued quote must not change when the user later edits their settings.
  issuerSnapshot Json?

  validUntil DateTime?
  issuedAt   DateTime?

  /// R2 object key for the rendered PDF. Null until the quote is issued.
  pdfObjectKey String?

  lines QuoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sequence])
  @@unique([userId, number])
  @@index([projectId, createdAt])
}

/// One priced line on a quotation.
model QuoteLine {
  id      String @id @default(uuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  position    Int
  description String

  /// Quantity in thousandths, so 2.5 m2 is 2500. Quantities are genuinely
  /// fractional, but the arithmetic that reaches money must stay integer
  /// (ARCHITECTURE 10).
  quantityMilli Int
  unitLabel     String?

  unitPriceCents Int

  /// quantityMilli * unitPriceCents / 1000, rounded half away from zero and
  /// stored, so the printed line total is the exact figure that was summed.
  lineTotalCents Int

  @@unique([quoteId, position])
}

/// An append-only record of consequential actions.
///
/// Written for the things that change what a project means or what someone can
/// act on: a specification approved, a design accepted, a quote issued, a
/// package generated, a version restored, a project or material removed.
/// Routine reads and recalculations are deliberately absent — an audit trail
/// nobody can scan is not an audit trail.
///
/// Writing an event must never fail the action it records. Every call site logs
/// and continues, because losing a history entry is not a reason to undo an
/// issued quote.
model AuditEvent {
  id String @id @default(uuid())

  /// The user who performed it. Cascades on user delete: an event has no
  /// meaning detached from the person who did it, and the userId is required.
  /// The PROJECT link is nullable and set null instead, so deleting a project
  /// leaves behind the record that it existed and was deleted.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Dotted action name, e.g. "spec.approved" or "quote.issued".
  action String

  /// A short human sentence, written at the call site where the context is.
  summary String

  /// Structured detail — ids,version numbers, amounts. Never a client's private
  /// data beyond what the project already holds.
  detail Json?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}
