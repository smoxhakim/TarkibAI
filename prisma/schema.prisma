// Prisma schema for TARKIB.
// Postgres is hosted on Neon. `url` is the pooled connection used at runtime;
// `directUrl` is the non-pooled connection required by `prisma migrate`, because
// Neon's pooler runs in transaction mode and cannot execute migration DDL/advisory locks.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  clerkId            String   @unique
  email              String   @unique
  name               String?
  companyName        String?
  logoUrl            String?
  stripeCustomerId   String?
  subscriptionPlan   String   @default("trial") // trial | starter | pro
  subscriptionStatus String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects      Project[]
  materials     Material[]
  costSettings  CostSettings?
  quoteSettings QuoteSettings?
}

model CostSettings {
  id             String @id @default(uuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id])
  laborType      String @default("percent") // percent | fixed
  laborValue     Int    @default(0)
  transportType  String @default("manual") // percent | fixed | manual
  transportValue Int    @default(0)
  installType    String @default("percent")
  installValue   Int    @default(0)
  marginPercent  Int    @default(0)
  taxPercent     Int    @default(0)
  currency       String @default("MAD")
}

model QuoteSettings {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  logoUrl         String?
  primaryColorHex String?
  footerText      String?
  termsText       String?
  paymentDetails  String?
}

model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  title  String

  // Workflow stage. "archived" is deliberately NOT a value here: archiving is
  // orthogonal to progress, so it is tracked by archivedAt. That way restoring a
  // project returns it to the stage it had reached rather than losing it.
  status String @default("intake") // intake|spec_approved|calculated|quoted|production_ready

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  messages         ChatMessage[]
  files            File[]
  specs            ProjectSpec[]
  versions         ProjectVersion[]
  projectMaterials ProjectMaterial[]
  cuttingPlans     CuttingPlan[]
  diagrams         Diagram[]
  mockups          Mockup[]
  costs            ProjectCost[]
  documents        Document[]

  @@index([userId, archivedAt])
}

model ChatMessage {
  id                String  @id @default(uuid())
  projectId         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role              String // user|assistant
  content           String
  /// File ids attached to this message, as a JSON array of strings.
  attachmentFileIds Json?

  // Audit trail of tools the agent invoked on this turn (name + arguments).
  // The conversation sent to the model is rebuilt from the structured spec plus
  // plain user/assistant text, so tool plumbing is NOT replayed from here —
  // chat history is not the source of truth (PRD §9).
  toolCalls Json?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model File {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  type      String // photo|logo|sketch|reference|mockup_source|generated_diagram|generated_mockup

  /// R2 object key. Deliberately NOT a URL: a stored URL would be a standing
  /// grant of access to anyone who reads the row or a log line. Every read goes
  /// through an ownership check and a short-lived signed URL (ARCHITECTURE §8, §9).
  objectKey String @unique

  /// Name the user's file had on their machine, for display only. Never used to
  /// build the object key, which is generated server-side.
  originalName String

  mimeType  String
  sizeBytes Int

  /// pending until the browser's direct-to-R2 upload is confirmed and the object
  /// verified. Only "ready" files are ever shown or sent to the model.
  status String @default("pending") // pending|ready

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, status])
}

model ProjectSpec {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version    Int
  data       Json
  status     String    @default("draft") // draft|approved
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

model ProjectVersion {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  label         String
  specSnapshot  Json
  costSnapshot  Json?
  createdAt     DateTime @default(now())

  @@unique([projectId, versionNumber])
}

model Material {
  id             String  @id @default(uuid())
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  name           String
  category       String
  customCategory Boolean @default(false)
  supplier       String?

  /// How this material is measured and purchased, which decides which of the
  /// dimension fields below apply and what unitPriceCents refers to.
  /// linear | sheet | area | piece  (ARCHITECTURE §11)
  measurementModel String

  /// Standard stock dimensions in INTEGER MILLIMETRES.
  ///
  /// Integers, not floats: purchase counts are derived from these, and a
  /// floating-point remainder can flip a division and change how many bars or
  /// sheets someone buys. Millimetres cover every fabrication size exactly.
  ///
  /// linear -> standardLengthMm (e.g. a 6 m bar is 6000)
  /// sheet  -> sheetWidthMm + sheetHeightMm (e.g. 2440 x 1220)
  /// area   -> priced per m², no discrete stock size
  /// piece  -> sold individually, no dimensions required
  standardLengthMm Int?
  sheetWidthMm     Int?
  sheetHeightMm    Int?

  /// Millimetres. Decimal because real stock includes 0.5 mm and 3.5 mm.
  thicknessMm Decimal? @db.Decimal(8, 2)

  /// Price of ONE purchase unit, in minor currency units of the user's
  /// configured currency:
  ///   linear -> one standard-length bar
  ///   sheet  -> one sheet
  ///   area   -> one square metre
  ///   piece  -> one piece
  unitPriceCents Int

  /// Extensible domain properties (kerf, minimum usable remnant, finish, colour…).
  /// Kept out of dedicated columns so industry-specific rules can be added
  /// without reshaping the core entity (ARCHITECTURE §11).
  technicalProperties Json?

  notes String?

  /// Archived rather than deleted once referenced by a project, so historical
  /// calculations and quotes keep pointing at a material that still exists.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projectMaterials ProjectMaterial[]
  cuttingPlans     CuttingPlan[]

  @@index([userId, archivedAt])
  @@index([userId, category])
}

model ProjectMaterial {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  /// What the material is for on this project, in the user's own words.
  role String?

  /// How much of this material the project needs, stated by the user.
  /// Units follow the material's measurementModel: metres for linear, square
  /// metres for sheet and area, a count for piece.
  ///
  /// This is an INPUT, not a result. The engine derives everything below from
  /// it; it never invents it, because deriving a requirement from spec
  /// dimensions would mean assuming how the sign is built (PRD §5.3).
  requiredQuantity Decimal?

  /// Optional note recording how the user arrived at the requirement, e.g.
  /// "perimeter 2x(8+3)". Kept for auditability of a number the system did not
  /// compute.
  requiredDimensions String?

  /// When the requirement itself last changed.
  ///
  /// Deliberately separate from `updatedAt`: the calculation writes its results
  /// to this same row, which bumps `updatedAt`, so `updatedAt` cannot
  /// distinguish "the user changed the quantity" from "we just calculated".
  /// Using it for staleness marked every line stale the moment it was
  /// calculated.
  requirementUpdatedAt DateTime?

  /// Results. NULL until the calculation engine runs, never zero-filled.
  unitsToPurchase        Int?
  totalPurchasedQuantity Decimal?
  wasteQuantity          Decimal?
  wastePercent           Decimal?
  unitPriceCentsSnapshot Int?
  totalCostCents         Int?
  calculatedAt           DateTime?

  /// The material's stock dimensions and price as they were at calculation
  /// time. Without this, editing a material later would silently rewrite the
  /// explanation of a calculation that was already run and possibly quoted.
  calculationInputs Json?

  /// Approved spec version the calculation was run against, so the UI can warn
  /// that a newer approved spec has superseded it (PRD §24 stale data).
  specVersionAtCalculation Int?

  /// Set when the engine cannot support this material, e.g. stock dimensions
  /// are missing. The line stays uncalculated and says why, rather than
  /// producing a number nobody can justify.
  unsupportedReason String?

  manualOverride Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// One row per material per project; quantities belong in the fields above,
  /// not in duplicate rows.
  @@unique([projectId, materialId])
  @@index([projectId])
}

model CuttingPlan {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material @relation(fields: [materialId], references: [id])
  sheetSizeLabel  String
  layoutData      Json
  wastePercent    Decimal
  diagramImageUrl String
  createdAt       DateTime @default(now())
}

model Diagram {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           String   @default("front_view")
  imageUrl       String
  dimensionsData Json
  createdAt      DateTime @default(now())
}

model Mockup {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFileId   String?
  resultImageUrl String
  prompt         String
  createdAt      DateTime @default(now())
}

model ProjectCost {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialsCostCents Int
  laborCostCents     Int
  transportCostCents Int
  installCostCents   Int
  internalTotalCents Int
  marginCents        Int
  taxCents           Int
  clientTotalCents   Int
  computedAt         DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // client_quote | production
  version   Int
  pdfUrl    String
  createdAt DateTime @default(now())
}
